# 线上环境
ENV = production

# 线上环境接口地址（部署时在 Cloudflare Pages 后台用环境变量覆盖为 Railway 后端地址）
VITE_API_URL = /api

# 部署到 Cloudflare Pages 根目录，覆盖基础 .env 里的 /vue-next-admin-preview/ 前缀
VITE_PUBLIC_PATH = /

# Cloudflare Pages 构建必需（避免 vite.config.ts 里 JSON.parse(undefined) 报错）
VITE_OPEN_CDN = false
VITE_PORT = 8888